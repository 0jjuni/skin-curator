# When set, the user must type this value on the frontend before AI diagnosis runs.
AI_PASSPHRASE=ai

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
